{
  // The site's pages and its Naru functions, rules and modules. `pnpm
  // build` compiles each file to JavaScript at the same path under dist/,
  // which is what Naru publishes; this only checks the types.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": [],
    // The SDK the pages load at run time, typed by its own declarations
    // (a copy of https://sdk.naru.pub/sdk/1.1.0/naru.d.ts).
    "paths": {
      "https://sdk.naru.pub/sdk/1.1.0/naru.js": ["./types/naru.d.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "vendor"]
}
