    "vendor:check": "node scripts/vendor-content.mjs --check"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "dompurify": "^3.4.17"
  }
}
