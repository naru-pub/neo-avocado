{
  "name": "neo-avocado",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "pnpm build && node --experimental-vm-modules --test tests/*.test.mjs",
    "test:e2e": "pnpm build && node tests/e2e.mjs",
    "sync:naru": "node scripts/sync-naru-types.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "vendor:content": "node scripts/vendor-content.mjs",
    "vendor:check": "node scripts/vendor-content.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@biomejs/js-api": "^3.0.0",
    "@biomejs/wasm-nodejs": "2.2.5",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "dompurify": "^3.4.17"
  },
  "packageManager": "pnpm@10.15.0"
}
